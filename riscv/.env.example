# Copy this file to .env in the riscv/ folder (do not commit .env).
# Plain text, no quotes around values.
# Team hosted DB (Neon) — use the connection string from the project invite.
HOSTED_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# If your tooling only reads DATABASE_URL, you can set it to the same URL instead:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
